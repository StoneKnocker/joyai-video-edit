{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyai-video-edit",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": ["nodejs_compat"],
  // Assets configuration.
  "assets": {
    "directory": "./build/client/"
  },
  // Cron disabled for waitlist-only deploy: Workers Free plan allows 5 crons/account (limit hit).
  // Re-enable for video task recovery when on Workers Paid, e.g.:
  // "triggers": { "crons": ["*/2 * * * *"] },
  // Secrets — optional for waitlist-only deploy (no payment/upload/auth providers required).
  // Add names here when those features are re-enabled; wrangler deploy validates required secrets.
  "env": {
    "dev": {
      "vars": {
        "APP_NAME": "JoyAI Video Edit",
        "APP_URL": "http://localhost:3000",
        "R2_DOMAIN": "https://cdn.joyaivideoedit.com",
        "ENVIRONMENT": "development",
        "NEED_MOCK": "0",
        "GOOGLE_CLIENT_ID": "989337603014-9d98h4bnqq60la9gm6jflohjpt3bbv3n.apps.googleusercontent.com",
        "SEND_FROM_EMAIL": "support@joyaivideoedit.com",
        "R2_ACCOUNT_ID": "d6fd0c73bd457f8cf7bacd8f66ac63a4",
        "R2_ACCESS_KEY_ID": "9ab844348a065605623905aaa51505f9",
        "R2_BUCKET_NAME": "joyai-video-edit",
        "PAYMENT_PROVIDER": "subotiz",
        "SUBOTIZ_ENABLED": "true",
        "CREEM_ENABLED": "false",
        "PAYPAL_ENABLED": "false",
        "PAYPAL_ENVIRONMENT": "sandbox",
        // Fixed ngrok domain so KIE can POST callbacks to local dev
        "KIE_CALLBACK_BASE_URL": "https://wholehearted-eleanor-nocturnal.ngrok-free.dev"
      },
      // KV namespaces configuration.
      "kv_namespaces": [
        {
          "binding": "APP_KV",
          "id": "514cc3047a144200be5571592d584727",
          "preview_id": "app_kv_preview_id"
        }
      ],
      // D1 databases configuration.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "joyai-video-edit",
          "database_id": "ef98c50b-3ce2-49e0-b7a3-083395b4688a",
          "migrations_dir": "drizzle"
        }
      ],
      // R2 buckets configuration.
      "r2_buckets": [
        {
          "bucket_name": "joyai-video-edit",
          "binding": "R2"
        }
      ],
      "secrets": {
        "required": []
      }
    },
    "prod": {
      "name": "joyai-video-edit",
      "routes": [
        { "pattern": "joyaivideoedit.com", "custom_domain": true }
      ],
      "vars": {
        "APP_NAME": "JoyAI Video Edit",
        "APP_URL": "https://joyaivideoedit.com",
        "R2_DOMAIN": "https://cdn.joyaivideoedit.com",
        "ENVIRONMENT": "production",
        "NEED_MOCK": "0",
        "GOOGLE_CLIENT_ID": "989337603014-9d98h4bnqq60la9gm6jflohjpt3bbv3n.apps.googleusercontent.com",
        "SEND_FROM_EMAIL": "support@joyaivideoedit.com",
        "R2_ACCOUNT_ID": "d6fd0c73bd457f8cf7bacd8f66ac63a4",
        "R2_ACCESS_KEY_ID": "9ab844348a065605623905aaa51505f9",
        "R2_BUCKET_NAME": "joyai-video-edit",
        "PAYMENT_PROVIDER": "subotiz",
        "SUBOTIZ_ENABLED": "true",
        "CREEM_ENABLED": "false",
        "PAYPAL_ENABLED": "false",
        "PAYPAL_ENVIRONMENT": "production"
      },
      // KV namespaces configuration.
      "kv_namespaces": [
        {
          "binding": "APP_KV",
          "id": "514cc3047a144200be5571592d584727",
          "preview_id": "app_kv_preview_id"
        }
      ],
      // D1 databases configuration.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "joyai-video-edit",
          "database_id": "ef98c50b-3ce2-49e0-b7a3-083395b4688a",
          "migrations_dir": "drizzle"
        }
      ],
      // R2 buckets configuration.
      "r2_buckets": [
        {
          "bucket_name": "joyai-video-edit",
          "binding": "R2"
        }
      ],
      "secrets": {
        "required": []
      }
    }
  },
  "observability": {
    // Configures automatic observability settings for telemetry data emitted from your Worker.
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
